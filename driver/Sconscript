import os
import rtconfig
from building import *

cwd = GetCurrentDir()

# add driver
src = Glob(os.path.join(cwd, 'accgyro', '*.c'))
src += Glob(os.path.join(cwd, 'baro', '*.c'))
src += Glob(os.path.join(cwd, 'spi_dev', '*.c'))
src += Glob(os.path.join(cwd, 'motor', '*.c'))
src += Glob(os.path.join(cwd, 'dshot', '*.c'))
src += Glob(os.path.join(cwd, 'gps', '*.c'))
src += Glob(os.path.join(cwd, 'sdio', '*.c'))

path = [
    cwd,                # 当前目录
    os.path.join(cwd, 'accgyro'),  # accgyro头文件目录
    os.path.join(cwd, 'baro'),  # baro头文件目录
    os.path.join(cwd, 'spi_dev'),  # spi_dev头文件目录
    os.path.join(cwd, 'motor'),  # motor头文件目录
    os.path.join(cwd, 'dshot'),  # dshot头文件目录
    os.path.join(cwd, 'gps'),  # gps头文件目录
    os.path.join(cwd, 'sdio')  # sdio头文件目录
]

group = DefineGroup('driver', src, depend = [''], CPPPATH = path)
Return('group')
